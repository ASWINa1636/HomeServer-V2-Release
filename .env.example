# Copy to .env. Generate unique secrets: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ENVIRONMENT=development
SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
POSTGRES_DB=homeserver_v2
POSTGRES_USER=homeserver_v2
POSTGRES_PASSWORD=replace-with-a-unique-database-password

# Browser interface. Existing server uses 8000; V2 defaults to 8081.
FRONTEND_PORT=8081
PUBLIC_BASE_URL=http://localhost:8081
TRUSTED_HOSTS=localhost,127.0.0.1,frontend
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_DAYS=14

# Email Delivery Provider: "smtp" (default for local development via Mailpit) or "resend"
EMAIL_PROVIDER=smtp

# Resend API configuration (required when EMAIL_PROVIDER=resend)
# Obtain an API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Sender address used for OTP verification and workspace invitation emails.
# NOTE FOR RESEND:
# To deliver emails to arbitrary recipient addresses in production, you must verify your custom
# domain in the Resend dashboard (Domains -> Add Domain) and configure SMTP_FROM with an address
# on that verified domain (e.g., HomeServer V2 <noreply@yourdomain.com>).
# The default Resend sandbox address (onboarding@resend.dev) only delivers to your account owner email.
SMTP_FROM=HomeServer V2 <noreply@example.test>

# Development SMTP points to Mailpit (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=homeserver-v2-mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAILPIT_UI_PORT=8025

OTP_MINUTES=5
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
REGISTRATION_POLICY=open

# This host directory is created if missing and bind-mounted at /data.
HOST_DATA_PATH=./data
APP_UID=1000
APP_GID=1000
MAX_UPLOAD_BYTES=104857600

# For production: ENVIRONMENT=production, COOKIE_SECURE=true, use a valid HTTPS
# PUBLIC_BASE_URL, set an external authenticated SMTP service, and rotate secrets.
